---
import home from "../../content/home.json";
import "../styles/site.css";

const getProgramTagClass = (style: string) => {
  if (style === "mad") return "tag-mad";
  if (style === "kultur") return "tag-kultur";
  return "tag-scene";
};

const getActivityCardClass = (style: string) => {
  if (style === "boern") return "cat-boern";
  if (style === "natur") return "cat-natur";
  if (style === "musik") return "cat-musik";
  return "cat-workshop";
};
---

<!DOCTYPE html>
<html lang="da">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{home.meta.title}</title>
    <meta name="description" content={home.meta.description} />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Instrument+Sans:wght@400;500;600;700&family=Playfair+Display:wght@400;700;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <section class="hero">
      <div class="hero-bg">
        <div class="strata">
          <div class="strata-layer"></div>
          <div class="strata-layer"></div>
          <div class="strata-layer"></div>
          <div class="strata-layer"></div>
          <div class="strata-layer"></div>
          <div class="strata-layer"></div>
          <div class="strata-layer"></div>
          <div class="strata-layer"></div>
        </div>
        <div class="cliff-cut"></div>
        <div class="grain"></div>
      </div>

      <div class="fossil-deco">
        <svg viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path
            d="M100 20 C60 20, 20 60, 20 100 C20 140, 60 180, 100 180 C140 180, 180 140, 180 100 C180 60, 140 20, 100 20 Z"
            stroke="#2A2520"
            stroke-width="2"
            fill="none"
          />
          <path
            d="M100 20 C85 60, 80 80, 100 100 C120 120, 115 140, 100 180"
            stroke="#2A2520"
            stroke-width="1.5"
            fill="none"
          />
          <path
            d="M20 100 C60 85, 80 80, 100 100 C120 120, 140 115, 180 100"
            stroke="#2A2520"
            stroke-width="1.5"
            fill="none"
          />
          <circle cx="100" cy="100" r="15" stroke="#2A2520" stroke-width="1" fill="none"></circle>
          <circle cx="100" cy="100" r="40" stroke="#2A2520" stroke-width="0.8" fill="none"></circle>
          <circle cx="100" cy="100" r="65" stroke="#2A2520" stroke-width="0.5" fill="none"></circle>
        </svg>
      </div>

      <div class="hero-content">
        <div class="hero-title-block">
          <h1>
            <span>{home.hero.titleLineOne}</span>
            <span class="line-kultur">{home.hero.titleLineTwo}</span>
          </h1>
          <p class="hero-subtitle">{home.hero.subtitle}</p>
        </div>
        <div class="hero-meta">
          <div class="date">{home.hero.dateLineOne}<br />{home.hero.dateLineTwo}</div>
          <div class="location">{home.hero.location}</div>
          <div class="time-badge">{home.hero.timeBadge}</div>
        </div>
      </div>

      <div class="scroll-hint">{home.hero.scrollHint}</div>
    </section>

    <div class="intro-band">
      <div class="intro-text">
        {home.intro.beforeHighlight} <strong>{home.intro.highlight}</strong> {home.intro.afterHighlight}
      </div>
      <div class="stats">
        {
          home.intro.stats.map((stat) => (
            <div class="stat">
              <div class="stat-number">{stat.value}</div>
              <div class="stat-label">{stat.label}</div>
            </div>
          ))
        }
      </div>
    </div>

    <section class="program">
      <div class="section-label">{home.program.label}</div>
      <div class="section-title">{home.program.title}</div>

      <div class="timeline">
        {
          home.program.items.map((item, index) => (
            <div class="timeline-item" style={`animation-delay: ${0.1 + index * 0.1}s`}>
              <div class="timeline-time">{item.time}</div>
              <div class="timeline-content">
                <h3>{item.title}</h3>
                <p>{item.description}</p>
                <span class={`timeline-tag ${getProgramTagClass(item.tagStyle)}`}>{item.tagLabel}</span>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="activities">
      <div class="section-label">{home.activities.label}</div>
      <div class="section-title">{home.activities.title}</div>

      <div class="act-grid">
        {
          home.activities.items.map((item, index) => (
            <div
              class={`act-card ${getActivityCardClass(item.categoryStyle)}`}
              style={`animation-delay: ${0.1 + index * 0.05}s`}
            >
              <div class="cat-label">{item.categoryLabel}</div>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mad-section">
      <div class="section-label">{home.food.label}</div>
      <div class="section-title">{home.food.title}</div>

      <div class="food-grid">
        {
          home.food.items.map((item, index) => (
            <div class="food-item" style={`animation-delay: ${0.1 + index * 0.05}s`}>
              <h4>{item.name}</h4>
              <p>{item.description}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="marked">
      <div class="section-label">{home.market.label}</div>
      <div class="section-title">{home.market.title}</div>

      <ul class="exhibitor-list">
        {home.market.items.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="praktisk">
      <div class="section-label">{home.practical.label}</div>
      <div class="section-title">{home.practical.title}</div>

      <div class="info-cards">
        {
          home.practical.items.map((item) => (
            <div class="info-card">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </div>
          ))
        }
      </div>
    </section>

    <footer>
      <div class="footer-title">{home.footer.title}</div>
      <p>{home.footer.summary}</p>
      <p style="margin-top: 1rem; opacity: 0.6; font-size: 0.8rem;">{home.footer.note}</p>
    </footer>
  </body>
</html>
